# Supabase Project URL
# Find it in Supabase Dashboard -> Project Settings -> API -> Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon public key
# Find it in Supabase Dashboard -> Project Settings -> API -> Project API keys -> anon public.
# This key is safe to expose to the browser when Row Level Security policies are correct.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional canonical site URL for auth redirects.
# Use this in Vercel production if you want to override the auto-detected deployment URL.
NEXT_PUBLIC_SITE_URL=

# Optional server-only key for the private initial typing API.
# Find it in Supabase Dashboard -> Project Settings -> API -> service_role.
# Never expose this value to browser code or commit a real key.
SUPABASE_SERVICE_ROLE_KEY=

# Optional bearer token required by POST /api/internal/type-vote.
# Generate a long random value and keep it only in server/script environments.
PERSONAMAP_INTERNAL_API_TOKEN=

# Optional Supabase auth.users UUID used as the owner for script-seeded typings.
# Create or choose a real confirmed Supabase user, then copy that user's UUID.
PERSONAMAP_SYSTEM_USER_ID=
